generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id           String   @id @default(uuid())
  first_name   String
  last_name    String
  email        String
  phone        String?
  company      String?
  country      String?
  service      String?
  company_size String?
  message      String
  status       String   @default("New")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("leads")
}
